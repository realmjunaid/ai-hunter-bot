# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
CHANNEL_ID=
# Optional: self-hosted RSSHub base. Default: public instance.
RSSHUB_BASE=
# Optional: comma-separated fallback instances.
RSSHUB_FALLBACKS=
# 1 = print embeds to console instead of posting (for testing).
DRY_RUN=0
# Provider alerts (OpenRouter + OpenCode Zen free add/remove) go here.
# X-post embeds go to CHANNEL_ID. Keep them different.
ALERT_CHANNEL_ID=
# Provider poll interval in seconds (min 60).
POLL_INTERVAL_SECONDS=300
# Optional: OpenRouter key (raises free-tier limits on their API).
OPENROUTER_API_KEY=
